# DataMind 2: Codex is the main agent; DataMind supplies data tools.
# Copy to .env.datamind. Keep secrets out of version control.
DATAMIND__DATA__PROFILE=default
# DATAMIND__DATA__BASE_DIR=/srv/datamind

# CLI / HTTP / UI Codex host. Omit model/provider to inherit Codex login/config.
# DATAMIND__CODEX__MODEL=your-supported-codex-model
# DATAMIND__CODEX__BASE_URL=https://your-gateway.example/v1
# DATAMIND__CODEX__API_KEY=your-private-key
# DATAMIND__CODEX__WORKSPACE=/srv/workspace
# DATAMIND__CODEX__REASONING_EFFORT=low
DATAMIND__CODEX__APPROVAL_MODE=auto_review
DATAMIND__CODEX__TIMEOUT_S=600
DATAMIND__CODEX__MAX_CONCURRENCY=4
# A trusted unattended host can use deny_all plus an explicitly authorized list.
# DATAMIND__CODEX__PREAPPROVED_TOOLS=["datamind_operation_begin"]

# KB embeddings are independent of the main Codex model.
DATAMIND__EMBEDDING__PROVIDER=openai
DATAMIND__EMBEDDING__API_BASE=https://api.openai.com/v1
DATAMIND__EMBEDDING__MODEL=text-embedding-3-small
# DATAMIND__EMBEDDING__API_KEY=your-embedding-key
# Or install .[huggingface] and use a local model:
# DATAMIND__EMBEDDING__PROVIDER=huggingface
# DATAMIND__EMBEDDING__MODEL=BAAI/bge-small-zh-v1.5
# DATAMIND__EMBEDDING__DIMENSION=512

DATAMIND__RETRIEVAL__STRATEGY=simple
DATAMIND__RETRIEVAL__TOP_K=5
DATAMIND__RETRIEVAL__CHUNK_SIZE=512
DATAMIND__RETRIEVAL__CHUNK_OVERLAP=64
DATAMIND__GRAPH__BACKEND=networkx
DATAMIND__DB__DIALECT=sqlite
DATAMIND__DB__READ_ONLY=true
DATAMIND__DB__ROW_LIMIT=1000
DATAMIND__MEMORY__BACKEND=sqlite
DATAMIND__HOOKS__ENABLED=true
# DATAMIND__HOOKS__PATH_ALLOWLIST_EXTRA=["/srv/authorized-documents"]
