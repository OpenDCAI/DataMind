# Merge selected settings into .env.datamind after filling the empty API fields.
# Do not load the blank endpoint: validation intentionally requires a valid URL.
DATAMIND__VIDEO__VISION__PROTOCOL=openai_chat_completions
DATAMIND__VIDEO__VISION__MODEL=qwen3.5-35b-a3b
DATAMIND__VIDEO__VISION__API_BASE=
DATAMIND__VIDEO__VISION__API_KEY=
DATAMIND__VIDEO__VISION__MAX_TOKENS=8192
DATAMIND__VIDEO__VISION__TIMEOUT_S=120
DATAMIND__VIDEO__ASR_MODEL_DIR=/path/to/models/faster-whisper/medium
DATAMIND__VIDEO__LANGUAGE_MODEL_DIR=/path/to/models/faster-whisper/tiny
DATAMIND__VIDEO__ASR_THREADS=4
DATAMIND__VIDEO__CACHE_REVISION=1
